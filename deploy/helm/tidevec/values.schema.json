{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessMode": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"] }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "threads": { "type": "integer", "minimum": 1 },
        "device": { "enum": ["auto", "cpu", "gpu", "tpu"] },
        "requireAuth": { "type": "boolean" },
        "ultraDurable": { "type": "boolean" },
        "segmentStore": { "type": "boolean" },
        "multiTenant": { "type": "boolean" },
        "rateLimitRps": { "type": "integer", "minimum": 0 },
        "otelEndpoint": { "type": "string" },
        "reembedAllow": { "type": "string" },
        "logLevel": { "enum": ["debug", "info", "warn", "error"] }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string" }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "intervalHours": { "type": "integer", "minimum": 1 },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        },
        "s3Uri": { "type": "string" },
        "gcsUri": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "apiKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "existingSecretClusterKey": { "type": "string", "minLength": 1 }
      }
    },
    "cluster": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secret": { "type": "string" }
      }
    },
    "probes": {
      "type": "object",
      "properties": {
        "startup": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "failureThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "extraEnv": { "type": "array" },
    "monitoring": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" },
            "tlsConfig": { "type": "object" }
          }
        }
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
